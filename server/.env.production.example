# PostgreSQL
POSTGRES_USER=sensor_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sensor_data

# Shared secret for POST /api/readings. Generate with: openssl rand -hex 32
SENSOR_API_KEY=replace-with-64-hex-chars

# Days of readings to keep. Cleanup runs hourly; 0 disables it.
RETENTION_DAYS=7

# Web Push air-quality alerts (optional). Generate a pair with:
#   pnpm vapid:keys
# Leave VAPID_PRIVATE_KEY empty to keep alerts disabled.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: set the public key only to verify it matches the private key.
# The server derives it automatically and serves it to the dashboard.
# VAPID_PUBLIC_KEY=
